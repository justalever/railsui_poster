# Twitter/X API Credentials
# Get these from https://developer.twitter.com/en/portal/dashboard

# Your app's API Key (also called Consumer Key)
X_API_KEY=your_api_key_here

# Your app's API Key Secret (also called Consumer Secret)
X_API_KEY_SECRET=your_api_key_secret_here

# Your Access Token
X_ACCESS_TOKEN=your_access_token_here

# Your Access Token Secret
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# OpenAI API Key (for AI-generated content)
# Get this from https://platform.openai.com/api-keys
# Optional: If not provided, will use fallback preset content
OPENAI_API_KEY=your_openai_api_key_here

# Debug mode (optional)
# Set to 'true' to see additional logging
DEBUG=false

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual credentials
# 3. Never commit the .env file to git (it's already in .gitignore)
#
# Twitter API Setup:
# - Create an app at https://developer.twitter.com/
# - Ensure your app has "Read and Write" permissions
# - Generate API keys and access tokens
#
# OpenAI API Setup:
# - Sign up at https://platform.openai.com/
# - Create an API key in your account settings
# - Add billing information (GPT-4o-mini is very affordable)
